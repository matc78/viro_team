rules_version = '2';

// Règles Firestore pour ViroTeam
// À adapter selon les rôles (admin/coach/player) et la structure members.
// Voir FIRESTORE_RULES.md pour la documentation.

service cloud.firestore {
  match /databases/{database}/documents {

    // Utilisateurs : lecture/écriture uniquement sur son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Clubs : lecture pour les utilisateurs connectés (affiner selon rôle/members si besoin)
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }
      match /teams/{teamId} {
        allow read, write: if request.auth != null;
      }
      match /events/{eventId} {
        allow read, write: if request.auth != null;
      }
      match /equipment/{docId} {
        allow read, write: if request.auth != null;
      }
      match /equipmentCatalog/{docId} {
        allow read, write: if request.auth != null;
      }
      match /equipment_loans/{docId} {
        allow read, write: if request.auth != null;
      }
      match /equipment_loan_requests/{docId} {
        allow read, write: if request.auth != null;
      }
      match /equipment_loan_change_requests/{docId} {
        allow read, write: if request.auth != null;
      }
      match /member_leaves/{docId} {
        allow read, write: if request.auth != null;
      }
      match /member_removals/{docId} {
        allow read, write: if request.auth != null;
      }
      match /announcements/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Demandes d'adhésion (collection racine)
    match /join_requests/{requestId} {
      allow read, write: if request.auth != null;
    }
  }
}
