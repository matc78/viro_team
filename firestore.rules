rules_version = '2';

// =============================================================================
// Règles Firestore ViroTeam – Production
// =============================================================================
// Rule set version: 3 (cotisations : canManageClubFees + membership roles)
// Incrémenter à chaque changement majeur des règles, puis lancer :
//   firebase deploy --only firestore:rules
// pour vérifier que le déploiement fonctionne.
// =============================================================================
// Principes : authentification obligatoire, accès par rôle (admin/coach/player),
// propriété des ressources (club, join_request). Les rôles sont dans users/{uid}
// (roles.player, roles.coach, roles.admin, roles.admin_fondateur).
// Document club : adminId, admins[], coaches[] (maintenu par l’app). Voir FIRESTORE_RULES.md.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Fonctions helper (évitent la duplication)
    // -------------------------------------------------------------------------

    // True si l’utilisateur connecté est admin du club (adminId ou dans admins)
    function isClubAdmin(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return request.auth != null
        && (request.auth.uid == club.get('adminId', '')
             || request.auth.uid in club.get('admins', []));
    }

    // True si l’utilisateur connecté peut écrire dans le club (admin ou coach ; coaches[] maintenu par l’app)
    function canWriteClub(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return request.auth != null
        && (request.auth.uid == club.get('adminId', '')
             || request.auth.uid in club.get('admins', [])
             || request.auth.uid in club.get('coaches', []));
    }

    // Staff (admin / coach) d’après le doc membership — utile si les tableaux du doc club sont désynchronisés
    function hasStaffRoleInMembership(clubId) {
      let path = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      return request.auth != null
        && exists(path)
        && get(path).data.get('roles', []).hasAny(['admin', 'admin_fondateur', 'coach']);
    }

    function canManageClubFees(clubId) {
      return canWriteClub(clubId) || hasStaffRoleInMembership(clubId);
    }

    function authUserEmail() {
      return request.auth == null
        ? ''
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '');
    }

    function isOwnedPendingMember(clubId, pendingMemberId) {
      let pendingPath = /databases/$(database)/documents/clubs/$(clubId)/pending_members/$(pendingMemberId);
      return request.auth != null
        && pendingMemberId != ''
        && exists(pendingPath)
        && get(pendingPath).data.get('email', '') == authUserEmail();
    }

    function canCreateMigratedOwnMemberFee(clubId, seasonId, userId) {
      let pendingId = request.resource.data.get('_migratedFromPendingId', '');
      let sourcePath = /databases/$(database)/documents/clubs/$(clubId)/fee_seasons/$(seasonId)/member_fees/$(pendingId);
      return request.auth != null
        && userId == request.auth.uid
        && pendingId != ''
        && pendingId != request.auth.uid
        && isOwnedPendingMember(clubId, pendingId)
        && exists(sourcePath)
        && request.resource.data.diff(get(sourcePath).data).affectedKeys().hasOnly(['_migratedFromPendingId']);
    }

    function canFinalizeMigratedOwnMemberFee(userId) {
      return request.auth != null
        && userId == request.auth.uid
        && resource.data.get('_migratedFromPendingId', '') != ''
        && request.resource.data.get('_migratedFromPendingId', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_migratedFromPendingId']);
    }

    function canDeleteMigratedPendingMemberFee(clubId, seasonId, userId) {
      let targetPath = /databases/$(database)/documents/clubs/$(clubId)/fee_seasons/$(seasonId)/member_fees/$(request.auth.uid);
      let targetAfter = getAfter(targetPath).data;
      return request.auth != null
        && userId != request.auth.uid
        && isOwnedPendingMember(clubId, userId)
        && (
          exists(targetPath)
          || (targetAfter != null
              && targetAfter.get('_migratedFromPendingId', '') == userId
              && targetAfter.diff(resource.data).affectedKeys().hasOnly(['_migratedFromPendingId']))
        );
    }

    // Membre du club (joueur listé, coach, ou admin) — pour lecture paramètres cotisation
    function isInClub(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      let uid = request.auth.uid;
      return request.auth != null
        && (uid == club.get('adminId', '')
             || uid in club.get('admins', [])
             || uid in club.get('coaches', [])
             || uid in club.get('members', []));
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // Lecture : utilisateur connecté (nécessaire pour liste membres / join_requests).
    // Écriture : propriétaire OU admin du club lors d'acceptation/refus de demande.
    // - Propriétaire : update/delete sur son propre document.
    // - Admin accepte : le document mis à jour contient activeContext.clubId,
    //   l'appelant doit être admin de ce club (isClubAdmin(activeContext.clubId)).
    // - Admin refuse : le document peut contenir lastProcessedJoinRequestClubId,
    //   l'appelant doit être admin de ce club.
    // -------------------------------------------------------------------------
    function isClubAdminForUserWrite() {
      let clubId = request.resource.data.get('activeContext', {}).get('clubId', '');
      return clubId != '' && isClubAdmin(clubId);
    }
    function isClubAdminForRefusedRequest() {
      let clubId = request.resource.data.get('lastProcessedJoinRequestClubId', '');
      return clubId != '' && isClubAdmin(clubId);
    }
    // Admin du club met à jour un autre user (transfert propriété, retrait équipe/club, changement rôle)
    function isClubAdminForAdminClubId() {
      let clubId = request.resource.data.get('_adminClubId', '');
      return clubId != '' && isClubAdmin(clubId);
    }
    // Coach/admin met à jour uniquement trainingStats d'un autre user (prise de présence entraînement)
    function isCoachUpdatingTrainingStats() {
      let clubId = request.resource.data.get('_trainingStatsClubId', '');
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return clubId != ''
        && canWriteClub(clubId)
        && changedKeys.hasOnly(['trainingStats', '_trainingStatsClubId']);
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Suppression de son propre document (évite tout souci request.resource sur delete)
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId
             || isClubAdminForUserWrite()
             || isClubAdminForRefusedRequest()
             || isClubAdminForAdminClubId()
             || isCoachUpdatingTrainingStats());

      // Modération avatar (sous-collection) : lecture/écriture par le propriétaire uniquement
      match /avatar_moderation/state {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // True si l'utilisateur ne fait qu'ajouter son uid aux members du club (inscription via lien d'invite).
    function isAddingSelfToMembers(clubId) {
      let uid = request.auth.uid;
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
        && changedKeys.hasOnly(['members'])
        && (uid in request.resource.data.get('members', []))
        && !(uid in resource.data.get('members', []));
    }

    // True si l'utilisateur ne fait que se retirer lui-même des membres/coaches du club
    // (nécessaire pour la suppression de compte depuis player_profil_page).
    function isSelfRemovalFromClub(clubId) {
      let uid = request.auth.uid;
      let oldData = resource.data;
      let newData = request.resource.data;
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let inMembers = uid in oldData.get('members', []);
      let inCoaches = uid in oldData.get('coaches', []);
      let onlyMembersOrCoachesChanged = changedKeys.hasOnly(['members'])
        || changedKeys.hasOnly(['coaches'])
        || changedKeys.hasOnly(['members', 'coaches']);
      let membersOnlySelfRemoved = (!changedKeys.hasAny(['members']))
        || (inMembers && !(uid in newData.get('members', [])));
      let coachesOnlySelfRemoved = (!changedKeys.hasAny(['coaches']))
        || (inCoaches && !(uid in newData.get('coaches', [])));
      return request.auth != null
        && (inMembers || inCoaches)
        && onlyMembersOrCoachesChanged
        && membersOnlySelfRemoved
        && coachesOnlySelfRemoved;
    }

    // -------------------------------------------------------------------------
    // clubs/{clubId}
    // Lecture : tout utilisateur connecté (recherche de club, accès au club actif).
    // Création : tout utilisateur connecté (création de club).
    // Mise à jour / suppression : uniquement les admins du club, ou retrait de soi (suppression de compte).
    // -------------------------------------------------------------------------
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if isClubAdmin(clubId) || isSelfRemovalFromClub(clubId) || isAddingSelfToMembers(clubId);
      allow delete: if isClubAdmin(clubId);

      // Membres du club : lecture par tout connecté (liste membres), écriture par admin/coach
      // ou par tout utilisateur connecté (nécessaire pour la migration one-shot depuis l'app sur la base test ;
      // en prod, préférer lancer la migration via Admin SDK et restreindre à canWriteClub(clubId) uniquement)
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId) || request.auth != null;
      }

      // Équipes : lecture par tout connecté, écriture par admin/coach ou par un membre qui s'ajoute (lien d'invite) ou se retire (quitter le club)
      match /teams/{teamId} {
        allow read: if request.auth != null;
        allow create: if canWriteClub(clubId);
        allow update: if canWriteClub(clubId)
          || (request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('members', [])
              && (
                  request.auth.uid in request.resource.data.get('playerIds', [])
                  || (request.auth.uid in resource.data.get('playerIds', [])
                      && !(request.auth.uid in request.resource.data.get('playerIds', []))
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds']))
              ));
        allow delete: if canWriteClub(clubId);
      }

      // Événements : lecture par tout connecté ; écriture par admin/coach, ou joueur pour sa propre présence ou pour se retirer (quitter le club)
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create, delete: if canWriteClub(clubId);
        allow update: if canWriteClub(clubId)
          || (request.auth != null
              && request.auth.uid in resource.data.get('teamMemberIds', [])
              && (
                  // Joueur met à jour sa présence (présent/absent)
                  (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance'])
                   && request.resource.data.get('attendance', {}).diff(resource.data.get('attendance', {})).affectedKeys().hasOnly([request.auth.uid])
                   && (!(request.auth.uid in request.resource.data.get('attendance', {}))
                       || request.resource.data.get('attendance', {}).get(request.auth.uid, '') in ['present', 'absent']))
                  // Idem + métadonnées de réponse (délai) : uniquement la clé du joueur dans attendanceMeta
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance', 'attendanceMeta'])
                   && request.resource.data.get('attendance', {}).diff(resource.data.get('attendance', {})).affectedKeys().hasOnly([request.auth.uid])
                   && (!(request.auth.uid in request.resource.data.get('attendance', {}))
                       || request.resource.data.get('attendance', {}).get(request.auth.uid, '') in ['present', 'absent'])
                   && request.resource.data.get('attendanceMeta', {}).diff(resource.data.get('attendanceMeta', {})).affectedKeys().hasOnly([request.auth.uid]))
                  // Joueur se retire de l'événement (quitter le club) : seul retrait de son uid de teamMemberIds et de attendance
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamMemberIds', 'attendance'])
                      && !(request.auth.uid in request.resource.data.get('teamMemberIds', []))
                      && !(request.auth.uid in request.resource.data.get('attendance', {})))
              ))
          // Membre du club s'ajoute à l'événement (acceptation lien d'invite) : ajout de son uid à teamMemberIds et attendance
          || (request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('members', [])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamMemberIds', 'attendance'])
              && request.auth.uid in request.resource.data.get('teamMemberIds', [])
              && !(request.auth.uid in resource.data.get('teamMemberIds', []))
              && request.resource.data.get('attendance', {}).diff(resource.data.get('attendance', {})).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.get('attendance', {}).get(request.auth.uid, '') in ['none', 'present', 'absent'])
          // Membre du club retire un id des événements (acceptation invite : retrait du pendingMemberId)
          || (request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('members', [])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamMemberIds', 'attendance'])
              && request.auth.uid in request.resource.data.get('teamMemberIds', [])
              && request.auth.uid in resource.data.get('teamMemberIds', [])
              && resource.data.get('teamMemberIds', []).size() == request.resource.data.get('teamMemberIds', []).size() + 1);
      }

      // Équipement et catalogue
      match /equipment/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /equipmentCatalog/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Prêts et demandes de prêt
      match /equipment_loans/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /equipment_loan_requests/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /equipment_loan_change_requests/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Départs et retraits de membres : admin/coach ou un membre qui enregistre son propre départ (quitter le club)
      match /member_leaves/{docId} {
        allow read: if request.auth != null;
        allow create: if canWriteClub(clubId)
          || (request.auth != null && request.resource.data.userId == request.auth.uid);
        allow update, delete: if canWriteClub(clubId);
      }
      match /member_removals/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Membres en attente : admin/coach ou suppression/update par l'utilisateur dont l'email correspond (inscription via lien ou refus d'invitation).
      // Un membre du club peut aussi supprimer (acceptation d'invite : suppression de son pending_member après ajout au club).
      match /pending_members/{docId} {
        allow read: if request.auth != null;
        allow create: if canWriteClub(clubId);
        allow update: if canWriteClub(clubId)
          || (request.auth != null
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == resource.data.get('email', ''));
        allow delete: if canWriteClub(clubId)
          || (request.auth != null
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == resource.data.get('email', ''))
          || (request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('members', []));
      }

      // Liens d'invite (création de compte) : lecture par quiconque possède le lien (docId = token).
      // Le docId est le token (haute entropie, Random.secure(), non devinable) ; la lecture publique
      // par ID est intentionnelle pour permettre le signup sans connexion. Création par admin/coach ;
      // mise à jour (usedAt) par tout utilisateur connecté si pas encore utilisé.
      match /invite_links/{inviteId} {
        allow read: if true;
        allow create: if canWriteClub(clubId);
        allow update: if canWriteClub(clubId)
          || (request.auth != null && resource.data.get('usedAt', null) == null);
        allow delete: if canWriteClub(clubId);
      }

      // Annonces
      match /announcements/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Présences réelles aux entraînements (un doc par joueur par event)
      // Lecture : tout membre connecté ; écriture : admin/coach uniquement
      match /training_attendances/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Cotisations : consignes et grille (lecture membres du club ; écriture staff)
      match /fee_settings/{docId} {
        allow read: if canManageClubFees(clubId) || isInClub(clubId);
        allow write: if canManageClubFees(clubId);
      }

      // Tournois & Championnats : lecture par tout connecté, écriture par admin/coach
      match /tournaments/{tournamentId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);

        match /tournament_teams/{teamId} {
          allow read: if request.auth != null;
          allow write: if canWriteClub(clubId);
        }
        match /tournament_matches/{matchId} {
          allow read: if request.auth != null;
          allow write: if canWriteClub(clubId);
        }
        match /tournament_phases/{phaseId} {
          allow read: if request.auth != null;
          allow write: if canWriteClub(clubId);
        }
      }

      // Cotisations legacy (member_fees) — conservé pour compatibilité données existantes
      match /member_fees/{userId} {
        allow read: if canManageClubFees(clubId) || request.auth.uid == userId;
        allow write: if canManageClubFees(clubId);
      }

      // Cotisations multi-saisons : paramètres et grille tarifaire par saison
      // Lecture : membres du club ; écriture : staff (admin/coach)
      match /fee_seasons/{seasonId} {
        allow read: if canManageClubFees(clubId) || isInClub(clubId);
        allow write: if canManageClubFees(clubId);

        // Suivi des cotisations par joueur dans une saison
        // Lecture : soi-même ou staff ; écriture : staff uniquement,
        // sauf migration contrôlée pendingMemberId -> uid avec marqueur transitoire.
        match /member_fees/{userId} {
          allow read: if canManageClubFees(clubId) || request.auth.uid == userId;
          allow create: if canManageClubFees(clubId)
            || canCreateMigratedOwnMemberFee(clubId, seasonId, userId);
          allow update: if canManageClubFees(clubId)
            || canFinalizeMigratedOwnMemberFee(userId);
          allow delete: if canManageClubFees(clubId)
            || canDeleteMigratedPendingMemberFee(clubId, seasonId, userId);
        }
      }
    }

    // -------------------------------------------------------------------------
    // join_requests/{requestId} (collection racine)
    // Création : tout utilisateur connecté (déposer une demande).
    // Lecture : le demandeur (userId) ou un admin/coach du club (clubId).
    // Mise à jour / suppression : le demandeur (annuler) ou un admin/coach du club (accepter/refuser).
    // -------------------------------------------------------------------------
    match /join_requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
             || canWriteClub(resource.data.clubId));
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
             || canWriteClub(resource.data.clubId));
    }

    // -------------------------------------------------------------------------
    // Requête collection group sur pending_members (PendingMemberMergeService)
    // Un utilisateur connecté peut lire les pending_members dont l'email correspond au sien
    // (pour fusionner les invitations après acceptation d'un lien ou inscription).
    // -------------------------------------------------------------------------
    match /{path=**}/pending_members/{docId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == resource.data.get('email', '');
    }

    // -------------------------------------------------------------------------
    // avatar_moderation_logs (traçabilité modération avatars)
    // Écriture : uniquement par le backend (Cloud Functions, Admin SDK).
    // Lecture : refusée côté client (réservé admin/support via console ou outil interne).
    // -------------------------------------------------------------------------
    match /avatar_moderation_logs/{logId} {
      allow read, write: if false;
    }
  }
}
