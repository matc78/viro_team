rules_version = '2';

// =============================================================================
// Règles Firestore ViroTeam – Production
// =============================================================================
// Principes : authentification obligatoire, accès par rôle (admin/coach/player),
// propriété des ressources (club, join_request). Les rôles sont dans users/{uid}
// (roles.player, roles.coach, roles.admin, roles.admin_fondateur).
// Document club : adminId, admins[], coaches[] (maintenu par l’app). Voir FIRESTORE_RULES.md.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Fonctions helper (évitent la duplication)
    // -------------------------------------------------------------------------

    // True si l’utilisateur connecté est admin du club (adminId ou dans admins)
    function isClubAdmin(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return request.auth != null
        && (request.auth.uid == club.get('adminId', '')
             || request.auth.uid in club.get('admins', []));
    }

    // True si l’utilisateur connecté peut écrire dans le club (admin ou coach ; coaches[] maintenu par l’app)
    function canWriteClub(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return request.auth != null
        && (request.auth.uid == club.get('adminId', '')
             || request.auth.uid in club.get('admins', [])
             || request.auth.uid in club.get('coaches', []));
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // Lecture : utilisateur connecté (nécessaire pour liste membres / join_requests).
    // Écriture : propriétaire OU admin du club lors d'acceptation/refus de demande.
    // - Propriétaire : update/delete sur son propre document.
    // - Admin accepte : le document mis à jour contient activeContext.clubId,
    //   l'appelant doit être admin de ce club (isClubAdmin(activeContext.clubId)).
    // - Admin refuse : le document peut contenir lastProcessedJoinRequestClubId,
    //   l'appelant doit être admin de ce club.
    // -------------------------------------------------------------------------
    function isClubAdminForUserWrite() {
      let clubId = request.resource.data.get(['activeContext', 'clubId'], '');
      return clubId != '' && isClubAdmin(clubId);
    }
    function isClubAdminForRefusedRequest() {
      let clubId = request.resource.data.get('lastProcessedJoinRequestClubId', '');
      return clubId != '' && isClubAdmin(clubId);
    }
    // Admin du club met à jour un autre user (transfert propriété, retrait équipe/club, changement rôle)
    function isClubAdminForAdminClubId() {
      let clubId = request.resource.data.get('_adminClubId', '');
      return clubId != '' && isClubAdmin(clubId);
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null
        && (request.auth.uid == userId
             || isClubAdminForUserWrite()
             || isClubAdminForRefusedRequest()
             || isClubAdminForAdminClubId());
    }

    // -------------------------------------------------------------------------
    // clubs/{clubId}
    // Lecture : tout utilisateur connecté (recherche de club, accès au club actif).
    // Création : tout utilisateur connecté (création de club).
    // Mise à jour / suppression : uniquement les admins du club.
    // -------------------------------------------------------------------------
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isClubAdmin(clubId);

      // Membres du club : lecture par tout connecté (liste membres), écriture par admin/coach
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Équipes : lecture par tout connecté, écriture par admin/coach
      match /teams/{teamId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Événements
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Équipement et catalogue
      match /equipment/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /equipmentCatalog/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Prêts et demandes de prêt
      match /equipment_loans/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /equipment_loan_requests/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /equipment_loan_change_requests/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Départs et retraits de membres
      match /member_leaves/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
      match /member_removals/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }

      // Annonces
      match /announcements/{docId} {
        allow read: if request.auth != null;
        allow write: if canWriteClub(clubId);
      }
    }

    // -------------------------------------------------------------------------
    // join_requests/{requestId} (collection racine)
    // Création : tout utilisateur connecté (déposer une demande).
    // Lecture : le demandeur (userId) ou un admin du club (clubId).
    // Mise à jour / suppression : le demandeur (annuler) ou un admin du club (accepter/refuser).
    // -------------------------------------------------------------------------
    match /join_requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
             || isClubAdmin(resource.data.clubId));
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
             || isClubAdmin(resource.data.clubId));
    }

    // -------------------------------------------------------------------------
    // avatar_moderation_logs (traçabilité modération avatars)
    // Écriture : uniquement par le backend (Cloud Functions, Admin SDK).
    // Lecture : refusée côté client (réservé admin/support via console ou outil interne).
    // -------------------------------------------------------------------------
    match /avatar_moderation_logs/{logId} {
      allow read, write: if false;
    }
  }
}
